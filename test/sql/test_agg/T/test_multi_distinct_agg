-- name: test_multi_distinct_agg
set enable_multi_distinct_to_grouping_sets_olap = true;

CREATE TABLE IF NOT EXISTS emps (
  emp_id INT,
  deptno INT,
  sal DECIMAL(10, 2),
  gender STRING,
  age INT
) ENGINE=OLAP
PROPERTIES (
"replication_num" = "1"
);

INSERT INTO emps VALUES
(1, 10, 5000.00, 'Male', 30),
(2, 10, 6000.00, 'Female', 28),
(3, 10, 5000.00, 'Male', 32),
(4, 10, 7000.00, 'Female', 40),
