-- name: test_kolmogorov_smirnov_test

drop database if exists kolmogorov_smirnov_test_test_db;
create database kolmogorov_smirnov_test_test_db;
use kolmogorov_smirnov_test_test_db;
drop table if exists kolmogorov_smirnov_test_test_tbl;
create table kolmogorov_smirnov_test_test_tbl
(
    `treatment` boolean,
    `numerator` double,
    `denominator` boolean,
    `numerator_pre` bigint,
    `denominator_pre` boolean,
    `Y` double,
    `X1` int,
    `X2` int,
    `X3` int,
    `X3_string` string,
    `X7_needcut` bigint,
    `X8_needcut` bigint,
    `weight` double,
    `distance` double,
    `uin` bigint
)
properties (
    "replication_num"="1"
);
shell: curl --location-trusted -u root: -T ${root_path}/lib/../common/data/stream_load/all_in_sql_test.csv -XPUT -H column_separator:, ${url}/api/kolmogorov_smirnov_test_test_db/kolmogorov_smirnov_test_test_tbl/_stream_load
sync;
select count(*), floor(sum(`numerator`)), floor(sum(`Y`)) from kolmogorov_smirnov_test_test_tbl;
select 'kolmogorov_smirnov_test',  
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'asymp'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'asymp'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'asymp'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'auto'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'exact'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'asymp')
from kolmogorov_smirnov_test_test_tbl;


select /*+ SET_VAR (streaming_preaggregation_mode = 'force_preaggregation',new_planner_agg_stage = '2') */ 'kolmogorov_smirnov_test',  
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'asymp'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'less', 'asymp'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'auto'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'exact'),
  kolmogorov_smirnov_test(numerator, treatment, 'greater', 'asymp'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'auto'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'exact'),
  kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'asymp')
from kolmogorov_smirnov_test_test_tbl;


select /*+ SET_VAR (streaming_preaggregation_mode = 'force_streaming',new_planner_agg_stage = '2') */ 'kolmogorov_smirnov_test',  
kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'auto'),
kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'exact'),
kolmogorov_smirnov_test(numerator, treatment, 'two-sided', 'asymp'),
kolmogorov_smirnov_test(numerator, treatment, 'less', 'auto'),
kolmogorov_smirnov_test(numerator, treatment, 'less', 'exact'),
kolmogorov_smirnov_test(numerator, treatment, 'less', 'asymp'),
kolmogorov_smirnov_test(numerator, treatment, 'greater', 'auto'),
kolmogorov_smirnov_test(numerator, treatment, 'greater', 'exact'),
kolmogorov_smirnov_test(numerator, treatment, 'greater', 'asymp'),
kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'auto'),
kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'exact'),
kolmogorov_smirnov_test(denominator, treatment, 'two-sided', 'asymp')
from kolmogorov_smirnov_test_test_tbl;
