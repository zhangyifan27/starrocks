select floor(t2.deptno),
count(distinct case when t4.age > 0 THEN t2.age + 1 ELSE NULL END),
count(distinct case when t2.age > 10 THEN t4.age + 10 ELSE NULL END),
sum(t4.sal) from (
  select deptno, sal, gender, age
  from (select * from emps where emp_id < 100) `t1`
  group by deptno, sal, gender, age
) `t2`
LEFT JOIN (
  select deptno, sal, age
  from (select * from emps where emp_id < 200) `t3`
  group by deptno, sal, age
) `t4`
on t2.deptno = t4.deptno
