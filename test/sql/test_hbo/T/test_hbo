-- name: test_hbo
create database if not exists hbo_test;
use hbo_test;

drop table if exists hbo_join_side_opt_test1;
drop table if exists hbo_join_side_opt_test2;

create table hbo_join_side_opt_test1(a int, b int) distributed by hash(a) buckets 32 properties("replication_num"="1");
insert into hbo_join_side_opt_test1 select generate_series, generate_series from TABLE(generate_series(1, 10000));
insert into hbo_join_side_opt_test1 select 1,1 from TABLE(generate_series(1, 10000000));
analyze full table hbo_join_side_opt_test1 with sync mode;

create table hbo_join_side_opt_test2(a int, b int) distributed by hash(a) buckets 32 properties("replication_num"="1");
insert into hbo_join_side_opt_test2 select generate_series, generate_series from TABLE(generate_series(1, 10000));
analyze full table hbo_join_side_opt_test2 with sync mode;
set enable_hbo_optimization=false;
set global enable_hbo_info_collection=false;

