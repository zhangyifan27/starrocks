-- name: test_tdw_substr
-- function: tdw_substr
set enable_hive_mode=true;

-- 1. 起始位置为 0
select tdw_substr('abcde', 0, 3);
select __thive_udf_db_.substr('abcde', 0, 3);
select substr('abcde', 0, 3);

-- 2. 起始位置为 1
select tdw_substr('abcde', 1, 3);
select __thive_udf_db_.substr('abcde', 1, 3);
select substr('abcde', 1, 3);

-- 3. 起始位置为负数
select tdw_substr('abcde', -2, 3);
select __thive_udf_db_.substr('abcde', -2, 3);
select substr('abcde', -2, 3);

-- 4. 长度超过剩余字符
select tdw_substr('abcde', 2, 10);
select __thive_udf_db_.substr('abcde', 2, 10);
select substr('abcde', 2, 10);

-- 5. 长度为负数
select tdw_substr('abcde', 2, -1);
select __thive_udf_db_.substr('abcde', 2, -1);
select substr('abcde', 2, -1);

-- 6. 起始位置越界(正向)
select tdw_substr('abcde', 10, 1);
select __thive_udf_db_.substr('abcde', 10, 1);
select substr('abcde', 10, 1);

-- 7. 输入为 NULL
select tdw_substr(NULL, 1, 1);
select __thive_udf_db_.substr(NULL, 1, 1);
select substr(NULL, 1, 1);
select tdw_substr('abc', NULL, 1);
select __thive_udf_db_.substr('abc', NULL, 1);
select substr('abc', NULL, 1);
select tdw_substr('abc', 1, NULL);
select __thive_udf_db_.substr('abc', 1, NULL);
select substr('abc', 1, NULL);

-- 8. 只有两个参数的情况
select tdw_substr('abcde', 2);
select __thive_udf_db_.substr('abcde', 2);
select substr('abcde', 2);
select tdw_substr('abcde', 0);
select __thive_udf_db_.substr('abcde', 0);
select substr('abcde', 0);
select tdw_substr('abcde', -2);
select __thive_udf_db_.substr('abcde', -2);
select substr('abcde', -2);

-- 10. 起始位置远小于 0
select tdw_substr('abcde', -10, 3);
select __thive_udf_db_.substr('abcde', -10, 3);
select substr('abcde', -10, 3);

-- 11. 长度参数为 0
select tdw_substr('abcde', 1, 0);
select __thive_udf_db_.substr('abcde', 1, 0);
select substr('abcde', 1, 0);

-- 12. 输入字符串为空
select tdw_substr('', 1, 1);
select __thive_udf_db_.substr('', 1, 1);
select substr('', 1, 1);

-- 9. 表测试
create table test_tdw_substr_tbl(c0 varchar(20), c1 int, c2 int)
        DUPLICATE KEY(c0)
        DISTRIBUTED BY HASH(c0)
        BUCKETS 1
        PROPERTIES('replication_num'='1');

insert into test_tdw_substr_tbl values 
('abcde', 0, 3),
('abcde', 1, 3),
('abcde', -2, 3),
('abcde', 2, 10),
('abcde', 2, -1),
('abcde', 10, 1),
(NULL, 1, 1);

select tdw_substr(c0, c1, c2) from test_tdw_substr_tbl order by c0, c1, c2;
select __thive_udf_db_.substr(c0, c1, c2) from test_tdw_substr_tbl order by c0, c1, c2;
select substr(c0, c1, c2) from test_tdw_substr_tbl order by c0, c1, c2;

drop table test_tdw_substr_tbl;
